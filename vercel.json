{
  "rewrites": [
    { "source": "/((?!mimensajero\\.apk$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/mimensajero.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"mimensajero.apk\"" }
      ]
    }
  ]
}
