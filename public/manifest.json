  "shortcuts": [
    {
      "name": "Chats",
      "short_name": "Chats",
      "description": "Abrir chats",
      "url": "/",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mi Mensajero"
    }
  ]
}
